{
  "name": "v2ex-dsh-client",
  "version": "0.1.0",
  "description": "Read-only V2EX browsing and discovery for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "dsh.plugin.json", "README.md", "README_ZH.md", "LICENSE"],
  "engines": { "node": ">=22", "dsh": ">=0.2.1-rc.5 <0.3.0" },
  "keywords": ["dsh-plugin", "deepseek-harness", "v2ex", "read-only"],
  "author": "oday0311 <oday0311@hotmail.com>",
  "repository": { "type": "git", "url": "git+https://github.com/oday0311/-dsh-v2ex-client.git" },
  "homepage": "https://github.com/oday0311/-dsh-v2ex-client#readme",
  "bugs": { "url": "https://github.com/oday0311/-dsh-v2ex-client/issues" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts test/client/*.test.ts test/client/*.test.tsx",
    "test:integration": "node --import tsx --test test/integration/*.test.ts",
    "test:e2e": "node test/e2e/harness/build.mjs && playwright test",
    "verify:live-api": "tsx scripts/verify-live-api.ts",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": { "zod": "4.4.3" },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.5",
    "@playwright/test": "1.61.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "lucide-react": "1.68.0",
    "pngjs": "7.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5 <0.3.0",
    "react": "^18.3.1"
  }
}
